# Copie este arquivo para .env. Não envie .env para Git.
# Sem chave, o modo Demonstracao continua disponivel quando a API estiver iniciada.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Opcional: após retries internos do SDK se houver HTTP 503/504, tentar outro
# modelo COM sua autorização. Pode gerar custo adicional e ter qualidade distinta.
# Confirme acesso aos dois modelos com VERIFICAR_GEMINI.bat.
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Para demo sem dados privados (padrão):
CONTROLS_SOURCE=data/controles_demo.json
# Para rodar com a planilha privada, copiar o XLSX para data/privado/ e ajustar:
# CONTROLS_SOURCE=data/privado/SBK_Framework_NIST.xlsx
CONTROLS_SHEET=PT-BR
MAX_IMAGE_BYTES=8388608
AUDIT_LOG_ENABLED=false
# Frontend servido pelo FastAPI é same-origin; só preencha se houver outro front:
CORS_ORIGINS=

# Uma nova chamada opcional se o modelo retornar resposta sem formato válido.
GEMINI_FORMAT_RETRY=true
